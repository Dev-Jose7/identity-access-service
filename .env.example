# Copy this file to .env for local development.
# .env is not versioned and is the main local source of configuration values.
# ------------------------------------------------------------
# Spring profiles
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SPRING_PROFILES_ACTIVE_DOCKER=docker

# ------------------------------------------------------------
# Common app settings (non-sensitive)
# ------------------------------------------------------------
SPRING_APPLICATION_NAME=identity-access-service
APP_PORT=8080
SERVER_PORT=8080
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# ------------------------------------------------------------
# Local app profile values (used by application-local.yml)
# ------------------------------------------------------------
APP_LOCAL_R2DBC_URL=r2dbc:postgresql://localhost:5432/identity_access
APP_LOCAL_R2DBC_USERNAME=identity_access
APP_LOCAL_R2DBC_PASSWORD=identity_access
APP_LOCAL_REDIS_HOST=localhost
APP_LOCAL_REDIS_PORT=6379
APP_LOCAL_REDIS_PASSWORD=identity_access
APP_LOCAL_REDIS_TIMEOUT=2s
APP_LOCAL_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_LOCAL_KAFKA_CLIENT_ID=identity-access-service-local
APP_LOCAL_KAFKA_CONSUMER_GROUP_ID=identity-access-service-local

# ------------------------------------------------------------
# Docker app profile values (used by application-docker.yml)
# ------------------------------------------------------------
APP_DOCKER_R2DBC_URL=r2dbc:postgresql://postgres:5432/identity_access
APP_DOCKER_R2DBC_USERNAME=identity_access
APP_DOCKER_R2DBC_PASSWORD=identity_access
APP_DOCKER_REDIS_HOST=redis
APP_DOCKER_REDIS_PORT=6379
APP_DOCKER_REDIS_PASSWORD=identity_access
APP_DOCKER_REDIS_TIMEOUT=2s
APP_DOCKER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APP_DOCKER_KAFKA_CLIENT_ID=identity-access-service-docker
APP_DOCKER_KAFKA_CONSUMER_GROUP_ID=identity-access-service-docker

# ------------------------------------------------------------
# Local infrastructure source of truth (docker-compose)
# ------------------------------------------------------------
POSTGRES_DB=identity_access
POSTGRES_USER=identity_access
POSTGRES_PASSWORD=identity_access
POSTGRES_PORT=5432

REDIS_PASSWORD=identity_access
REDIS_PORT=6379

KAFKA_EXTERNAL_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"

# ------------------------------------------------------------
# Service-level technical placeholders (non-sensitive defaults)
# ------------------------------------------------------------
APP_SECURITY_JWT_ISSUER=identity-access-service
APP_SECURITY_JWT_AUDIENCE=arka-b2b
APP_SECURITY_JWT_ACCESS_TTL_SECONDS=900
APP_SECURITY_JWT_REFRESH_TTL_SECONDS=604800
APP_SECURITY_JWT_CLOCK_SKEW_SECONDS=60
APP_SECURITY_JWT_JWKS_PATH=/.well-known/jwks.json

APP_REDIS_CACHE_INTROSPECTION_TTL_SECONDS=30
APP_REDIS_CACHE_PERMISSIONS_TTL_SECONDS=30
APP_REDIS_RATE_LIMIT_LOGIN_RPM=10

APP_KAFKA_TOPIC_USER_LOGGED_IN=iam.user-logged-in.v1
APP_KAFKA_TOPIC_AUTH_FAILED=iam.auth-failed.v1
APP_KAFKA_TOPIC_SESSION_REFRESHED=iam.session-refreshed.v1
APP_KAFKA_TOPIC_SESSION_REVOKED=iam.session-revoked.v1
APP_KAFKA_TOPIC_SESSIONS_REVOKED_BY_USER=iam.sessions-revoked-by-user.v1
APP_KAFKA_TOPIC_ROLE_ASSIGNED=iam.role-assigned.v1
APP_KAFKA_TOPIC_USER_BLOCKED=iam.user-blocked.v1
APP_KAFKA_TOPIC_ORGANIZATION_SUSPENDED=directory.organization-suspended.v1

APP_OUTBOX_RELAY_ENABLED=true
APP_OUTBOX_RELAY_BATCH_SIZE=200
APP_OUTBOX_RELAY_POLL_INTERVAL_MS=2000
APP_OUTBOX_RELAY_MAX_RETRIES=3
APP_IDEMPOTENCY_CONSUMER_NAME=identity-access-service

# ------------------------------------------------------------
# Production baseline (set in real env/secret manager, no fallback)
# ------------------------------------------------------------
# SPRING_R2DBC_URL=
# SPRING_R2DBC_USERNAME=
# SPRING_R2DBC_PASSWORD=
# SPRING_DATA_REDIS_HOST=
# SPRING_DATA_REDIS_PORT=
# SPRING_DATA_REDIS_PASSWORD=
# SPRING_KAFKA_BOOTSTRAP_SERVERS=
# APP_SECURITY_JWT_ISSUER=
# APP_SECURITY_JWT_AUDIENCE=
# SPRING_PROFILES_ACTIVE=prod
